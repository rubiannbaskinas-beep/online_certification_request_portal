{
  "name": "Real Property Online Certification Portal",
  "short_name": "Assessor Portal",
  "description": "Request and track real property and tax certifications from the Municipal Assessor's Office.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f1f5f9",
  "theme_color": "#0f172a",
  "categories": ["government", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Request Certification", "url": "/?view=submit", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Track Application", "url": "/?view=track", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
